# Supabase (Project Settings > API). A publishable key pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor (Vercel > Settings > Environment Variables). Nunca use NEXT_PUBLIC_ nestas.
# Chave secreta do Supabase (Project Settings > API Keys > Secret keys): publica o convite depois do pagamento.
SUPABASE_SECRET_KEY=
# Mercado Pago, aplicação Niver-app (Checkout Transparente, API de Orders) > Credenciais.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Niver-app > Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=
# "1" enquanto MERCADOPAGO_ACCESS_TOKEN for de teste: o Pix sai com o pagador APRO e é aprovado sozinho.
# Apague ao trocar para as credenciais de produção.
MERCADOPAGO_TEST_PAYER=
